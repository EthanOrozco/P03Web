# No repetir los POST exitosos sin reiniciar los datos: correos y contraseñas son únicos.
#--------------- PUNTO 1 ---------------

### Raíz sin auth: 200, HTML de login
GET http://localhost:3000/ HTTP/1.1

### Raíz con auth: 200, HTML de home
GET http://localhost:3000/ HTTP/1.1
x-auth: test

### home sin auth: 401
GET http://localhost:3000/home.html HTTP/1.1

### home con auth: 200, HTML correspondiente
GET http://localhost:3000/home.html HTTP/1.1
x-auth: test

### tasks sin auth: 401
GET http://localhost:3000/tasks.html HTTP/1.1

### tasks con auth: 200, HTML correspondiente
GET http://localhost:3000/tasks.html HTTP/1.1
x-auth: test

### Login sin auth: 200, HTML de login
GET http://localhost:3000/login.html HTTP/1.1


#--------------- PUNTO 2 ---------------

### Consultar usuarios: 200, colección vacía al iniciar
GET http://localhost:3000/users?page=1&limit=10 HTTP/1.1
x-auth: admin_auth

### Consultar usuarios sin auth: 401
GET http://localhost:3000/users?page=1&limit=10 HTTP/1.1

### Consultar usuarios con auth incorrecta: 401
GET http://localhost:3000/users?page=1&limit=10 HTTP/1.1
x-auth: incorrecta


#--------------- PUNTO 3 ---------------

### Crear usuario 1: registro exitoso, sin x-auth
POST http://localhost:3000/users HTTP/1.1
Content-Type: application/json

{
  "name": "Usuario 1",
  "email": "usuario1@example.com",
  "password": "prueba001",
  "confirm_password": "prueba001"
}

### Crear usuario 2: registro exitoso, sin x-auth
POST http://localhost:3000/users HTTP/1.1
Content-Type: application/json

{
  "name": "Usuario 2",
  "email": "usuario2@example.com",
  "password": "prueba002",
  "confirm_password": "prueba002"
}

### Crear usuario 3: registro exitoso, sin x-auth
POST http://localhost:3000/users HTTP/1.1
Content-Type: application/json

{
  "name": "Usuario 3",
  "email": "usuario3@example.com",
  "password": "prueba003",
  "confirm_password": "prueba003"
}

### Registro con confirmación distinta: 400, no crea usuario
POST http://localhost:3000/users HTTP/1.1
Content-Type: application/json

{
  "name": "No guardar",
  "email": "no-guardar@example.com",
  "password": "prueba004",
  "confirm_password": "diferente"
}

### Registro con correo repetido: 400, no crea usuario
POST http://localhost:3000/users HTTP/1.1
Content-Type: application/json

{
  "name": "No guardar",
  "email": "usuario1@example.com",
  "password": "prueba004",
  "confirm_password": "prueba004"
}

### Registro con contraseña repetida: 400, no crea usuario
POST http://localhost:3000/users HTTP/1.1
Content-Type: application/json

{
  "name": "No guardar",
  "email": "no-guardar@example.com",
  "password": "prueba001",
  "confirm_password": "prueba001"
}

